<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vaani"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="On-device voice control for your phone. Nothing leaves the device."
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTalk"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Hold a thought, tap to talk"     android:textSize="16sp"
            android:minHeight="56dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Setup"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant microphone, contacts, phone, SMS"     android:textSize="16sp"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen control"     android:textSize="16sp"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/btnMediaAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Media control access"     android:textSize="16sp"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Floating mic permission"     android:textSize="16sp"
            android:minHeight="56dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Switches"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Keep Vaani running (survives reboot)" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAutoPunctuation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Add punctuation while dictating" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swConfirmOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Ask me before an order or payment (summary card)" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swHandsFree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Hands-free: listen for the wake word" />

        <EditText
            android:id="@+id/etWakePhrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="wake phrase, e.g. vaani / वाणी / suno vaani"
            android:inputType="text"
            android:maxLines="1" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swFollowUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Stay open for a follow-up after each command" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAutoLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Auto language hint (code-mixed speech)" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Floating mic bubble" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swSpeak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Speak replies out loud" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swLlm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:text="Use local model for odd phrasing (optional)" />

        <Button
            android:id="@+id/btnMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory"     android:textSize="16sp"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/btnVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voice: Default"     android:textSize="16sp"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear log"     android:textSize="16sp"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/btnDeleteRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete taught recipes"     android:textSize="16sp"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/btnResetSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset all settings"     android:textSize="16sp"
            android:minHeight="56dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Try a command by typing it"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="play lofi beats on spotify"
            android:inputType="text"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run"     android:textSize="16sp"
            android:minHeight="56dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Log"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="11sp"
            android:text="Vaani v3.7.0" />
    </LinearLayout>
</ScrollView>
